{
	"lanes": {
		"shortcut-handbuilt": {
			"id": "shortcut-handbuilt",
			"command": "npx",
			"args": [
				"tsx",
				"--env-file=<absolute-path-to-repo>/.env",
				"<absolute-path-to-repo>/servers/shortcut-handbuilt/src/index.ts"
			]
		},
		"shortcut-naive": {
			"id": "shortcut-naive",
			"command": "npx",
			"args": [
				"tsx",
				"--env-file=<absolute-path-to-repo>/.env",
				"<absolute-path-to-repo>/servers/naive/src/index.ts"
			]
		}
	}
}
